NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Database (PostgreSQL via Podman — mapped to host port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=kabari_user
DB_PASSWORD=kabari_pass
DB_NAME=kabari_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# File Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760
