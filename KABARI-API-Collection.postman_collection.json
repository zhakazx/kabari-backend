    {
      "name": "1. Authentication",
      "description": "Endpoints untuk registrasi, login, dan manajemen token JWT",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"pelanggan\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Registrasi akun baru. Role tersedia: pelanggan, kreator, penerima_tamu, admin"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has access_token and user_id', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.success).to.be.true;",
                  "  pm.expect(jsonData.data.access_token).to.exist;",
                  "  pm.expect(jsonData.data.user_id).to.exist;",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.access_token) {",
                  "  pm.collectionVariables.set('access_token', jsonData.data.access_token);",
                  "}",
                  "if (jsonData.data && jsonData.data.user_id) {",
                  "  pm.collectionVariables.set('user_id', jsonData.data.user_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
